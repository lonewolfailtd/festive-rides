# Convex backend (uni tool + bookings)
# Set automatically by `npx convex dev`. NEXT_PUBLIC_CONVEX_URL is the
# only var the Next.js app reads; CONVEX_DEPLOYMENT and the SITE_URL are
# managed by the Convex CLI.
NEXT_PUBLIC_CONVEX_URL=https://xxxxx.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://xxxxx.convex.site
CONVEX_DEPLOYMENT=dev:xxxxx

# Resend Email Service
# Used for booking verification emails AND uni magic-link sign-in.
RESEND_API_KEY=re_xxxxx

# App Configuration
ADMIN_EMAIL=sammipetersen1720@yahoo.co.nz
NEXT_PUBLIC_APP_URL=https://festiverides.online

# Upstash Redis (for rate limiting; leave empty in dev to use in-memory fallback)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AxxxXXxxx

# Security tuning (all optional with sensible defaults)
MAX_REQUEST_SIZE_BYTES=1048576
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
DUPLICATE_BOOKING_WINDOW_HOURS=24
MIN_FORM_SUBMISSION_TIME_MS=3000

# Cleanup endpoint API key
CLEANUP_API_KEY=your-secure-random-key-here

# OpenRouter (for the uni AI features — Assignment Analyser, Draft Coach, etc.)
# Set this on the Convex deployment via `npx convex env set OPENROUTER_API_KEY ...`
# rather than locally, so server functions can read it.
# OPENROUTER_API_KEY=sk-or-...
