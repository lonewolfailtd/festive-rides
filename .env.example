# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# Resend Email Service
RESEND_API_KEY=re_xxxxx

# App Configuration
ADMIN_EMAIL=sammipetersen1720@yahoo.co.nz
NEXT_PUBLIC_APP_URL=https://festiverides.online

# Upstash Redis Configuration (for Rate Limiting)
# Sign up at https://upstash.com and create a Redis database
# Leave these empty for development mode (rate limiting will be disabled)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AxxxXXxxx

# Additional Security Configuration (Optional - defaults will be used if not set)
# Maximum request body size in bytes (default: 1048576 = 1MB)
MAX_REQUEST_SIZE_BYTES=1048576

# Rate limiting configuration (in addition to Upstash Redis)
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=10         # Max requests per window per IP

# Duplicate booking prevention
DUPLICATE_BOOKING_WINDOW_HOURS=24  # Hours to block duplicate bookings from same IP

# Bot detection - minimum time to fill form (default: 3000ms = 3 seconds)
MIN_FORM_SUBMISSION_TIME_MS=3000

# Email Verification Configuration
# API key for cleanup endpoint (generate a secure random string)
CLEANUP_API_KEY=your-secure-random-key-here
